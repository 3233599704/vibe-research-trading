{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-core/parent-order-allocation-plan/v1",
  "type": "object",
  "required": [
    "schema",
    "batch_request_sha256",
    "trade_date",
    "account_fingerprint",
    "mode",
    "authorization_sha256",
    "child_intents",
    "internal_crosses",
    "parent_orders",
    "real_orders",
    "allocation_plan_sha256"
  ],
  "properties": {
    "schema": {"const": "quant-core/parent-order-allocation-plan/v1"},
    "batch_request_sha256": {"$ref": "#/$defs/sha256"},
    "trade_date": {"type": "string", "format": "date"},
    "account_fingerprint": {"type": "string", "minLength": 1, "maxLength": 160},
    "mode": {"enum": ["PAPER", "LIVE_AUTHORIZED"]},
    "authorization_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "child_intents": {
      "type": "array",
      "items": {"$ref": "#/$defs/childIntent"}
    },
    "internal_crosses": {
      "type": "array",
      "items": {"$ref": "#/$defs/internalCross"}
    },
    "parent_orders": {
      "type": "array",
      "items": {"$ref": "#/$defs/parentOrder"}
    },
    "real_orders": {"type": "boolean"},
    "allocation_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "symbol": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"},
    "positiveDecimal": {"type": "string", "pattern": "^(?:0*[1-9][0-9]*|0*\\.[0-9]*[1-9][0-9]*)$"},
    "childIntent": {
      "type": "object",
      "required": ["intent_id", "strategy_id", "code", "side", "quantity", "order_type", "limit_price", "reference_price", "source_receipt_sha256", "intent_sha256"],
      "properties": {
        "intent_id": {"$ref": "#/$defs/id"},
        "strategy_id": {"$ref": "#/$defs/id"},
        "code": {"$ref": "#/$defs/symbol"},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "integer", "minimum": 1},
        "order_type": {"enum": ["limit", "market"]},
        "limit_price": {"anyOf": [{"$ref": "#/$defs/positiveDecimal"}, {"type": "null"}]},
        "reference_price": {"$ref": "#/$defs/positiveDecimal"},
        "source_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "intent_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "internalCross": {
      "type": "object",
      "required": ["cross_id", "code", "quantity", "reference_price", "buy_strategy_id", "buy_intent_id", "sell_strategy_id", "sell_intent_id"],
      "properties": {
        "cross_id": {"$ref": "#/$defs/id"},
        "code": {"$ref": "#/$defs/symbol"},
        "quantity": {"type": "integer", "minimum": 1},
        "reference_price": {"$ref": "#/$defs/positiveDecimal"},
        "buy_strategy_id": {"$ref": "#/$defs/id"},
        "buy_intent_id": {"$ref": "#/$defs/id"},
        "sell_strategy_id": {"$ref": "#/$defs/id"},
        "sell_intent_id": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "residualClaim": {
      "type": "object",
      "required": ["intent_id", "strategy_id", "quantity", "intent_sha256"],
      "properties": {
        "intent_id": {"$ref": "#/$defs/id"},
        "strategy_id": {"$ref": "#/$defs/id"},
        "quantity": {"type": "integer", "minimum": 1},
        "intent_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "parentOrder": {
      "type": "object",
      "required": ["parent_order_id", "batch_request_sha256", "code", "side", "quantity", "order_type", "limit_price", "reference_price", "residual_claims"],
      "properties": {
        "parent_order_id": {"$ref": "#/$defs/id"},
        "batch_request_sha256": {"$ref": "#/$defs/sha256"},
        "code": {"$ref": "#/$defs/symbol"},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "integer", "minimum": 1},
        "order_type": {"enum": ["limit", "market"]},
        "limit_price": {"anyOf": [{"$ref": "#/$defs/positiveDecimal"}, {"type": "null"}]},
        "reference_price": {"$ref": "#/$defs/positiveDecimal"},
        "residual_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/residualClaim"}}
      },
      "additionalProperties": false
    }
  }
}
